<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">


    <com.folatkikoeru.app.MyWebView
        android:id="@+id/activity_main_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- 底部控制条 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp">

        <Button
            android:id="@+id/button"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:onClick="startFloatingButtonService"
            android:text="Lrc"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/button_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="startSubtitleMode"
            android:text="@string/button_subtitle"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/button_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="showColorPickerDialog"
            android:text="@string/button_color"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/button1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="startFloatingWebViewService"
            android:text="Lrc1"
            android:visibility="invisible" />

        <EditText
            android:id="@+id/editTextNumber2"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="number"
            android:text="15" />

    </LinearLayout>

    <!-- 字幕层：字幕模式下显示，全黑背景、居中大字 -->
    <TextView
        android:id="@+id/subtitle_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:textSize="48sp"
        android:textStyle="bold"
        android:shadowColor="#FF000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:visibility="gone" />

    <!-- 点击层：字幕模式下捕获点击以唤出控制条（透明，必须位于控制条之下） -->
    <View
        android:id="@+id/subtitle_touch_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 字幕亮度拉条：字幕模式下显示于左侧（竖向，上=更亮 下=更暗；视觉长度=宽度，运行时按屏高 60% 设置并平移回左缘） -->
    <SeekBar
        android:id="@+id/subtitle_brightness_seekbar"
        android:layout_width="320dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:rotation="270"
        android:min="20"
        android:max="100"
        android:progress="100"
        android:visibility="gone" />

    <!-- 字幕字号拉条：字幕模式下显示于底部 -->
    <SeekBar
        android:id="@+id/subtitle_size_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="48dp"
        android:layout_marginRight="48dp"
        android:layout_marginBottom="16dp"
        android:min="24"
        android:max="100"
        android:progress="48"
        android:visibility="gone" />

    <!-- 退出字幕模式按钮 -->
    <Button
        android:id="@+id/btn_exit_subtitle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="12dp"
        android:background="@drawable/exit_button_bg"
        android:onClick="exitSubtitleMode"
        android:text="@string/exit_subtitle"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- 字幕播放/暂停按钮（暂停时字幕不显示） -->
    <Button
        android:id="@+id/btn_subtitle_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/btn_exit_subtitle"
        android:layout_margin="12dp"
        android:background="@drawable/exit_button_bg"
        android:onClick="toggleSubtitlePause"
        android:text="@string/subtitle_pause_symbol"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />


</RelativeLayout>
